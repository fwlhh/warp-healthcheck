name: ci
on: [push, pull_request]

jobs:
  single:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: shellcheck
        run: |
          sudo apt-get update
          sudo apt-get install -y shellcheck
          shellcheck single/bin/*.sh single/scripts/*.sh \
                     single/tests/run.sh single/tests/cases/*.sh
      - name: single tests
        run: make -C single test

  fleet:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: py_compile
        run: |
          python3 -m py_compile fleet/coordinator/coordinator.py
          python3 -m py_compile fleet/agent/agent.py
      - name: fleet tests
        run: |
          chmod +x fleet/tests/run.sh
          fleet/tests/run.sh