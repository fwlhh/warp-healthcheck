[Unit]
Description=warp-coordinator (Telegram bot + HTTP API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/warp-coordinator run
Restart=always
RestartSec=5

EnvironmentFile=/etc/warp-coordinator.env

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=warp-coordinator

[Install]
WantedBy=multi-user.target