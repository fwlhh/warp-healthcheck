[Unit]
Description=warp-agent (heartbeat + command executor)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/warp-agent
Restart=always
RestartSec=5

EnvironmentFile=/etc/warp-agent.env

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=warp-agent

[Install]
WantedBy=multi-user.target