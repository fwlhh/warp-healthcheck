# warp-agent configuration.
# Copy to /etc/warp-agent.env and edit.
# NODE_NAME and NODE_TOKEN are printed by:
#   warp-coordinator add-node <name>

COORDINATOR_URL=http://10.0.0.1:8080
NODE_NAME=NODE_GE01
NODE_TOKEN=PASTE_TOKEN_HERE

# Optional
# Countries in which Google refuses the service: a restart is triggered when
# Google sees one of them as the exit's country (space or comma separated).
# BAD_COUNTRIES=RU

# The node's first WARP.
# WARP_PROXY=127.0.0.1:1080
# COMPOSE_DIR=/opt/warp
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_SERVICE=warp
# HEARTBEAT_INTERVAL=60
# POLL_INTERVAL=5
# CHECK_INTERVAL=300
# RESTART_COOLDOWN=60
# CURL_TIMEOUT=30
# STATE_DIR=/var/lib/warp-agent

# More WARPs on the same node: add a group of three lines per WARP, with the
# next number. There is no limit; every WARP is checked and restarted on its
# own (own country, own cooldown), and messages say "NODE / name".
#   WARP2_NAME=warp2                # shown in messages; default: the service name
#   WARP2_PROXY=127.0.0.1:1081      # SOCKS5 port; "127.0.0.1:1081:1080" (docker's
#                                   #   ports form) is accepted too
#   WARP2_SERVICE=warp2             # docker compose service to restart
#   WARP2_COMPOSE_DIR=/opt/warp     # optional, default COMPOSE_DIR
#   WARP2_COMPOSE_FILE=docker-compose.yml   # optional, default COMPOSE_FILE
# WARP3_NAME=...  WARP3_PROXY=...  WARP3_SERVICE=...  and so on.
# The first WARP can be named too:  WARP_NAME=warp   (default: COMPOSE_SERVICE)
