# warp-bot configuration (single mode).
# Copy to /etc/warp-bot.env and edit.

# Required
TG_TOKEN=PASTE_BOT_TOKEN_HERE
TG_CHAT_ID=0
NODE_NAME=unknown-node

# Optional
# Countries in which Google refuses the service (Gemini and others): Google
# seeing one of them as the exit's country restarts that WARP. Space or comma
# separated; set but empty = never restart because of the country.
# BAD_COUNTRIES=RU

# The first WARP.
# WARP_PROXY=127.0.0.1:1080
# COMPOSE_DIR=/opt/warp
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_SERVICE=warp
# CHECK_INTERVAL=300
# RESTART_COOLDOWN=60
# POLL_TIMEOUT=25
# POLL_BACKOFF_MIN=5
# POLL_BACKOFF_MAX=60
# CURL_TIMEOUT=10
# STATE_DIR=/var/lib/warp-bot

# More WARPs on the same machine: add a group of three lines per WARP with the
# next number; there is no limit. Every WARP is checked and restarted on its
# own (own proxy, own cooldown, own alerts) and messages say "NODE / name".
#   WARP2_NAME=warp2                # shown in messages; default: the service name
#   WARP2_PROXY=127.0.0.1:1081      # "127.0.0.1:1081:1080" (docker's ports form) works too
#   WARP2_SERVICE=warp2             # docker compose service to restart
#   WARP2_COMPOSE_DIR=/opt/warp     # optional, default COMPOSE_DIR
#   WARP2_COMPOSE_FILE=docker-compose.yml   # optional, default COMPOSE_FILE
# WARP3_NAME=...  WARP3_PROXY=...  WARP3_SERVICE=...  and so on.
# The first WARP can be named too:  WARP_NAME=warp   (default: COMPOSE_SERVICE)
