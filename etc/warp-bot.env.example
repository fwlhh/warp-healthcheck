# warp-healthcheck configuration.
# Copy to /etc/warp-bot.env and edit. Do not commit the real file.

# Required
TG_TOKEN=PASTE_BOT_TOKEN_HERE
TG_CHAT_ID=0
NODE_NAME=unknown-node

# Optional overrides
# WARP_PROXY=127.0.0.1:1080
# COMPOSE_DIR=/opt/warp
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_SERVICE=warp
# CHECK_INTERVAL=300
# RESTART_COOLDOWN=300
# POLL_TIMEOUT=25
# CURL_TIMEOUT=10
# STATE_DIR=/var/lib/warp-bot